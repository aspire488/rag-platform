# RAG Platform — local environment template (copy to .env; never commit .env)
# Placeholders only — no secrets. Defaults keep outbound network disabled.

# Egress guard (invariant I3 / Z4): off = no data leaves the machine except loopback Ollama
EGRESS_MODE=off

# Local Ollama endpoint (Z3)
OLLAMA_BASE_URL=http://localhost:11434

# API port
PORT=8000
